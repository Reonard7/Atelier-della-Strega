  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58a7eb668e0cb444f8479bb73aba6fdc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TrialDialogueController
  trial1Lines:
  - In this trial, you must make your way through a corridor as arrows burst from 
    the walls. At the end of the chamber, there are some treasure chests one holds
    the reward the others are mimics in disguise. Choose wisely.
  - In this trial, you must make your way through a corridor as arrows burst from 
    the walls. At the end of the chamber, there are some treasure chests one holds
    the reward the others are mimics in disguise. Choose wisely.
  trial2Lines:
  - 'Their dormant flames seem to await a careful hand. But beware the confined space
    makes some forms of magic dangerous. Only those who wisely choose how to wield
    their power will awaken the fire and reveal the hidden treasure. '
  - 'Their dormant flames seem to await a careful hand. But beware the confined space
    makes some forms of magic dangerous. Only those who wisely choose how to wield
    their power will awaken the fire and reveal the hidden treasure. '
  trial3Lines:
  - Unstable platforms hover in the void. A cold wind threatens to throw you off
    balance. Only those who master their agility can reach the highest platform,
    where a treasure awaits.
  - Unstable platforms hover in the void. A cold wind threatens to throw you off
    balance. Only those who master their agility can reach the highest platform,
    where a treasure awaits.
  retreatMessage: You escaped successfully
  completeMessage: You completed the trial!
  fireballMessage: This spell is too strong for enclosed spaces
  mimicMessage: 'You fled from the mimic just in time '
